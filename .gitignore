### LatexToMSWord ###
# intermediate pipeline files
build/
# private manuscripts and converted outputs -- never commit these
manuscript/
/*.docx
!template.docx
# PNG files rasterized from PDF figures by the filter
manuscript/tex/*.png
# working manuscripts: no file type under paper/ belongs in the repo
paper/